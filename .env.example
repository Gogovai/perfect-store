# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Canonical public URL
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Hubtel payment integration (server-only; confirm exact variables for your enabled Hubtel API)
HUBTEL_CLIENT_ID=your_hubtel_client_id
HUBTEL_CLIENT_SECRET=your_hubtel_client_secret
HUBTEL_MERCHANT_ACCOUNT_ID=your_hubtel_merchant_account_id

# Optional public customer support details (leave blank until configured)
NEXT_PUBLIC_STORE_SUPPORT_EMAIL=
NEXT_PUBLIC_STORE_SUPPORT_PHONE=
NEXT_PUBLIC_STORE_ADDRESS=
